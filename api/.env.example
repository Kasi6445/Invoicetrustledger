# Copy this file to .env  (cp .env.example .env)

PORT=3000
# change me — generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Ledger backend: mock | fabric | gcul
#   mock   = persistent hash-chained ledger file (works everywhere, no Docker) — this is also Plan B
#   fabric = real Hyperledger Fabric via Gateway SDK (needs the test network running + chaincode deployed)
#   gcul   = Google Cloud Universal Ledger adapter (stub until Google grants testnet access)
LEDGER_MODE=mock

# Gemini (Google AI Studio) key for the OCR feature. Leave empty to use the
# built-in simulated extraction so the demo still works offline.
GEMINI_API_KEY=paste-your-key-here

# Companies House REST key (developer.company-information.service.gov.uk) for the
# supplier register check. Leave empty to use the built-in cached snapshot; when
# set, the check calls the live register and falls back to the snapshot on error.
# CH_API_KEY=paste-your-key-here

# Seed the two demo invoices in-process at boot when the ledger is empty
# (used by hosted deploys whose disk resets on restart). Off by default locally.
# AUTO_SEED=true

# Hosted deploys (Render): set LEDGER_MODE=mock, AUTO_SEED=true, a real
# JWT_SECRET and (optionally) GEMINI_API_KEY — see render.yaml at repo root.

# Only needed when LEDGER_MODE=fabric — absolute path to fabric-samples
FABRIC_SAMPLES=/home/YOURUSERNAME/fabric/fabric-samples
