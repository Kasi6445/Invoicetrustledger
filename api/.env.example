# Copy this file to .env  (cp .env.example .env)

PORT=3000
JWT_SECRET=ledger-legends-demo-secret

# Ledger backend: mock | fabric | gcul
#   mock   = persistent hash-chained ledger file (works everywhere, no Docker) — this is also Plan B
#   fabric = real Hyperledger Fabric via Gateway SDK (needs the test network running + chaincode deployed)
#   gcul   = Google Cloud Universal Ledger adapter (stub until Google grants testnet access)
LEDGER_MODE=mock

# Gemini (Google AI Studio) key for the OCR feature. Leave empty to use the
# built-in simulated extraction so the demo still works offline.
GEMINI_API_KEY=

# Only needed when LEDGER_MODE=fabric — absolute path to fabric-samples
FABRIC_SAMPLES=/home/YOURUSERNAME/fabric/fabric-samples
